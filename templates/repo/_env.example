# Copy to .env (git-ignored). Never commit real keys.
# A value can be a 1Password reference instead of the key, e.g.
# ELEVENLABS_API_KEY="op://Private/ElevenLabs/credential". oncue reads it with the op CLI
# only when a command needs it (narrate, deploy).

# Narration (npx oncue narrate).
ELEVENLABS_API_KEY=

# Media hosting (oncue deploy), if you use the default Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Experiments only: override the house voice for one run. `npx oncue check` fails a take made this way.
# ONCUE_VOICE_ID=
# ONCUE_MODEL_ID=
# ONCUE_VOICE_SETTINGS={"stability":0.5}
